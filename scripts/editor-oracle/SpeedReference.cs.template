            return new {Nodes=nodes.Select(pair=>new{Row=pair.Key,Rate=pair.Value.Data.Rate,Rows=pair.Value.Data.PeriodLengthIntegerPosition,Seconds=pair.Value.Data.PeriodTimeSeconds,Time=pair.Value.Data.PreferPeriodAsTime}).ToArray(),Queries=input.GetProperty("Queries").EnumerateArray().Select(query=>{var row=query[0].GetDouble();var time=query[1].GetDouble();var node=nodes.LastOrDefault(pair=>pair.Key<=row).Value??nodes.FirstOrDefault().Value;var rate=node==null?1:node.Data.PreferPeriodAsTime?node.GetInterpolatedScrollRateFromTime(time):node.GetInterpolatedScrollRateFromRow(row);return new {Row=row,Time=time,Rate=rate};}).ToArray()};
        }
