            if(kind=="set"){
                var text=op[2].GetString()!;var (valid,rate,rows,seconds,time)=EditorInterpolatedRateAlteringEvent.IsValidScrollRateInterpolationString(text);
                if(!valid)error="invalid";
                else if(nodes.TryGetValue(row,out var node)){var old=(node.Data.Rate,node.Data.PeriodLengthIntegerPosition,node.Data.PeriodTimeSeconds,node.Data.PreferPeriodAsTime);node.StringValue=text;changed=old!=(node.Data.Rate,node.Data.PeriodLengthIntegerPosition,node.Data.PeriodTimeSeconds,node.Data.PreferPeriodAsTime);}
