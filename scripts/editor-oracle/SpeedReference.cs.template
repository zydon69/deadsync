internal static class Reference{
    public static object Run(JsonElement input){
        System.Globalization.CultureInfo.CurrentCulture=System.Globalization.CultureInfo.InvariantCulture;
        var source=new Dictionary<double,Tuple<double,double,int>>();new ScrollRateInterpolationPropertyParser("SPEEDS",source).Parse(new MSDFile.Value {Params=["SPEEDS",input.GetProperty("Source").GetString()!]});
        var chart=new Chart{Layers=[new Layer()]};SMCommon.AddScrollRateInterpolationEvents(source,chart,new TempoOracle.SilentLogger(),false);var store=new EditorChart();var nodes=new SortedDictionary<int,EditorInterpolatedRateAlteringEvent>();
        foreach(var e in chart.Layers[0].Events.OfType<ScrollRateInterpolation>())nodes[e.IntegerPosition]=new(e.IntegerPosition,e,store);
