internal static class Reference {
    public static object Run(JsonElement request) {
        var options=new JsonSerializerOptions {IncludeFields=true,ReadCommentHandling=JsonCommentHandling.Skip,AllowTrailingCommas=true,Converters={new JsonStringEnumConverter(JsonNamingPolicy.CamelCase)}};
        try {
            var text=request.GetProperty("Content").GetString()!;
            using var stream=new MemoryStream(System.Text.Encoding.UTF8.GetBytes(text));
            object profile=request.GetProperty("Kind").GetString() switch {
                "Pattern"=>JsonSerializer.Deserialize<PatternProfile>(stream,options)!,
                "Performed"=>JsonSerializer.Deserialize<PerformedProfile>(stream,options)!,
                "Expressed"=>JsonSerializer.Deserialize<ExpressedProfile>(stream,options)!,
                _=>throw new ArgumentException("Unknown profile kind")
            };
            Guid guid;string? name;string? description;StepManiaLibrary.Config config;
            switch(profile) {
                case PatternProfile p:guid=p.Guid;name=p.Name;description=p.Description;config=p.Config;break;
                case PerformedProfile p:guid=p.Guid;name=p.Name;description=p.Description;config=p.Config;break;
                case ExpressedProfile p:guid=p.Guid;name=p.Name;description=p.Description;config=p.Config;break;
                default:throw new ArgumentException("Invalid profile");
            }
            config.Init();
            return new {Success=true,Valid=guid!=Guid.Empty && config.Validate(),Guid=guid,Name=name,Description=description,
                Config=JsonSerializer.SerializeToElement(config,config.GetType(),options)};
        } catch(Exception) {return new {Success=false};}
    }
}
