// Original tick setter; explicit collections replace editor UI and event trees.
using System.Text.Json;
using Fumen.ChartDefinition;
namespace TickOracle;
internal sealed class EditorTickCountEvent(int row,TickCount value):PauseOracle.EditorEvent(row){
    private readonly TickCount TickCountEvent=value;private bool WidthDirty;
    // SETTER
}
internal static class Reference{
    public static object Run(JsonElement input){
        var source=new Dictionary<double,int>();foreach(var pair in input.GetProperty("Segments").EnumerateArray())source[pair[0].GetDouble()]=pair[1].GetInt32();
        var chart=new Chart{Layers=[new Layer()]};Fumen.Converters.SMCommon.AddTickCountEvents(source,chart,new TempoOracle.SilentLogger(),false);
        var store=new PauseOracle.EditorChart();var nodes=new SortedDictionary<int,EditorTickCountEvent>();
        foreach(var e in chart.Layers[0].Events.OfType<TickCount>())nodes[e.IntegerPosition]=new(e.IntegerPosition,e);
        store.EditorEvents.AddRange(nodes.Values);
        object Values()=>nodes.Select(pair=>new{Row=pair.Key,Ticks=pair.Value.IntValue}).ToArray();
        var initial=Values();var stages=new List<object>();
        foreach(var op in input.GetProperty("Operations").EnumerateArray()){
            var kind=op[0].GetString();var row=op[1].GetInt32();bool changed=false;string? error=null;
            if(kind=="set"){
                var ticks=op[2].GetInt32();
                if(ticks<0)error="invalid";
                else if(nodes.TryGetValue(row,out var node)){var before=node.IntValue;node.IntValue=ticks;changed=before!=node.IntValue;}
                else{nodes[row]=new(row,new(ticks));store.EditorEvents.Add(nodes[row]);changed=true;}
            }else if(kind=="remove"){
                if(nodes.Remove(row,out var node)){store.EditorEvents.Remove(node);changed=true;}
            }else if(kind=="move"){
                var target=op[2].GetInt32();
                if(!nodes.TryGetValue(row,out var node))error="missing";
                else if(row==target){}
                else if(!store.CanEventBeMovedToRow(node,target))error="collision";
                else{nodes.Remove(row);nodes[target]=node;node.Row=target;changed=true;}
            }
            stages.Add(new{Changed=changed,Error=error,Values=Values()});
        }
        return new{Initial=initial,Stages=stages};
    }
}
