// Development-only serialization/position oracle. Data types and methods are extracted
// unchanged from pinned GrooveAuthor sources, without the editor's UI/runtime.
using System.Text.Json;
using System.Text.Json.Serialization;
using static Fumen.Converters.SMCommon;
namespace MetadataOracle;
internal static class ExpressedChartConfigManager {
    public static readonly Guid DefaultExpressedChartDynamicConfigGuid=new("a19d532e-b0ce-4759-ad1c-02ecbbdf2efd");
}
internal class EditorPatternEvent {
    // DEFINITION
}
internal class EditorChart {
    // CUSTOM_DATA
    public sealed class Song { public double MusicOffset; public double SyncOffset; }
    public Song EditorSong=new();
    public Song GetEditorSong()=>EditorSong;
    public double MusicOffset;
    public bool UsesChartMusicOffset;
    // MUSIC_OFFSET
    // Actual Fumen input parsing plus the pinned constructor's enum/int projection.
    public static async Task<object> ReadIdentity(JsonElement request) {
        System.Globalization.CultureInfo.DefaultThreadCurrentCulture=System.Globalization.CultureInfo.InvariantCulture;
        System.Globalization.CultureInfo.CurrentCulture=System.Globalization.CultureInfo.InvariantCulture;
        var format=request.GetProperty("Format").GetString()!;
        var path=System.IO.Path.Combine(System.IO.Path.GetTempPath(),Guid.NewGuid()+"."+format);
        try {
            await File.WriteAllTextAsync(path,request.GetProperty("Content").GetString()!);
            Fumen.Converters.Reader reader=format=="sm"?new Fumen.Converters.SMReader(path):new Fumen.Converters.SSCReader(path);
            var song=await reader.LoadAsync(CancellationToken.None);
            return song.Charts.Select(chart=>new {Difficulty=Enum.TryParse<ChartDifficultyType>(chart.DifficultyType,out var difficulty)&&Enum.IsDefined(difficulty)?difficulty.ToString():null,Rating=(int)chart.DifficultyRating}).ToArray();
        } finally {File.Delete(path);}
    }
    public static object Run(JsonElement request) {
        var options=new JsonSerializerOptions {IncludeFields=true,ReadCommentHandling=JsonCommentHandling.Skip};
        try {
            var data=JsonSerializer.Deserialize<CustomSaveDataV1>(request.GetProperty("Content").GetString()!,options);
            if(request.TryGetProperty("SongOffset",out var song)) {
                var chart=new EditorChart {EditorSong=new Song {MusicOffset=song.GetDouble()},MusicOffset=data!.MusicOffset,UsesChartMusicOffset=data.ShouldUseChartMusicOffset};
                return new {Success=true,Data=JsonSerializer.SerializeToElement(data,options),EffectiveOffset=chart.GetMusicOffset()};
            }
            return new {Success=true,Data=JsonSerializer.SerializeToElement(data,options)};
        } catch(JsonException) {return new {Success=false};}
    }
}

internal class EditorPosition {
    // POSITION_METHODS
}
internal class EditorSong {
    // SONG_DATA
    public static object Run(JsonElement request) {
        var options=new JsonSerializerOptions {IncludeFields=true,ReadCommentHandling=JsonCommentHandling.Skip,Converters={new JsonStringEnumConverter(JsonNamingPolicy.CamelCase)}};
        var data=JsonSerializer.Deserialize<CustomSaveDataV1>(request.GetProperty("Content").GetString()!,options)!;
        var chart=new EditorChart {UsesChartMusicOffset=true,MusicOffset=request.GetProperty("MusicOffset").GetDouble(),EditorSong=new EditorChart.Song {SyncOffset=data.SyncOffset}};
        return new {SyncOffset=data.SyncOffset,Positions=request.GetProperty("Times").EnumerateArray().Select(value=>new {Time=value.GetDouble(),SongTime=EditorPosition.GetSongTimeFromChartTime(chart,value.GetDouble()),ChartTime=EditorPosition.GetChartTimeFromSongTime(chart,value.GetDouble())}).ToArray()};
    }
}
