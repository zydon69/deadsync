    private readonly Multipliers MultipliersEvent=value;private bool WidthDirty;
    public int Hit=>MultipliersEvent.HitMultiplier;public int Miss=>MultipliersEvent.MissMultiplier;
    // VALIDATOR
    // GETTER
    // SETTER
