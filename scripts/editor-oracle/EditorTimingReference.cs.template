// Development-only containers/accessors around unchanged pinned editor methods.
// No rendering, game input, audio, file loading or full editor runtime is emulated.
using System.Text.Json;
using Fumen;
using Fumen.ChartDefinition;
using Fumen.Converters;
using StepManiaLibrary;
using static Fumen.Converters.SMCommon;
namespace EditorTimingOracle;

internal class Cursor<T>(IList<T> values, int index) {
    private int Index=index;
    public T Current => values[Index];
    public bool MoveNext() { Index++; return Index>=0 && Index<values.Count; }
    public bool MovePrev() { Index--; return Index>=0 && Index<values.Count; }
}
internal class EventList<T> : List<T> {
    public void Validate() { }
    public int GetCount() => Count;
    public Cursor<T> First() => new(this,-1);
    public Cursor<T> Last() => new(this,Count-2);
}
internal class EventIntervalTree<T> : List<T> {
    public void Insert(T value,double start,double end) => Add(value);
}
internal class EditorEvent(EditorChart chart, Event data) {
    public Event Data=data;
    protected EditorChart EditorChart=chart;
    public double Time;
    public bool Fake;
    public bool IsPositionImmutable;
    public int GetRow() => Data.IntegerPosition;
    public double GetChartPosition() => GetRow();
    public double GetChartTime() => Time;
    public virtual double GetEndChartTime() => Time;
    public virtual double GetEndChartPosition() => GetRow();
    public virtual bool IsStep() => false;
    public virtual bool IsFake() => Fake;
    public void SetIsFakeDueToRow(bool fake) => Fake=fake;
    public void SetRowDependencies(double time,short relative,short denominator,bool fake) {Time=time;Data.TimeSeconds=time;Fake=fake;}
}
internal abstract class EditorPreviewRegionEvent(EditorChart chart, Event data) : EditorEvent(chart,data);
internal class EditorNoteEvent(EditorChart chart,LaneNote data) : EditorEvent(chart,data) {
    public int Lane => data.Lane;
    public string Symbol => data.SourceType;
    public override bool IsStep() => Symbol is "1" or "2" or "4" or "F" or "L";
    public override bool IsFake() => base.IsFake() || Symbol == "F";
}
internal class EditorHoldNoteEvent(EditorChart chart,LaneHoldStartNote data,int end) : EditorNoteEvent(chart,data) {
    private double EndTime;
    public void RefreshHoldEndTime() { EndTime=EditorChart.RateAlteringEvents.ForEvent(new LaneHoldEndNote {IntegerPosition=end}).GetChartTimeFromPosition(end); }
    public override double GetEndChartTime() => EndTime;
}
internal class EditorRateAlteringEvent(EditorChart chart, Event data) : EditorEvent(chart,data) {
    protected int WarpRowsRemaining;
    protected double StopTimeRemaining;
    protected double RowsPerSecond, SecondsPerRow;
