internal static class Reference {
    public static object Run(JsonElement request,string referenceRoot) {
        var chart=new EditorChart();
        foreach(var item in request.GetProperty("Timing").EnumerateArray()) {
            var row=item[0].GetInt32(); var kind=item[1].GetString();
            EditorEvent value=kind switch {
                "tempo"=>new EditorTempoEvent(chart,new Tempo(item[2].GetDouble())),
                "signature"=>new EditorTimeSignatureEvent(chart,new TimeSignature(new Fraction(item[2].GetInt32(),item[3].GetInt32()),0)),
                "stop"=>new EditorStopEvent(chart,new Stop(item[2].GetDouble())),
                "delay"=>new EditorDelayEvent(chart,new Stop(item[2].GetDouble(),true)),
                "warp"=>new EditorWarpEvent(chart,new Warp(item[2].GetInt32())),
                "fake"=>new EditorFakeSegmentEvent(chart,new FakeSegment(item[2].GetInt32())),
                "scroll"=>new EditorScrollRateEvent(chart,new ScrollRate(item[2].GetDouble())),
                "label"=>new EditorEvent(chart,new Label("label")),
                "tick"=>new EditorEvent(chart,new TickCount(4)),
                "combo"=>new EditorEvent(chart,new Multipliers(1,1)),
                "speed"=>new EditorEvent(chart,new ScrollRateInterpolation(1,48,0,false)),
                _=>throw new ArgumentException("Unknown editor timing event")
            };
            value.Data.IntegerPosition=row; chart.EditorEvents.Add(value);
        }
        foreach(var item in request.GetProperty("Notes").EnumerateArray()) {
            var symbol=item[2].GetString()!; var row=item[0].GetInt32();var lane=item[1].GetInt32();
            LaneNote data=symbol switch {"2" or "4"=>new LaneHoldStartNote(),"M" or "K"=>new LaneNote(),_=>new LaneTapNote()};
            data.IntegerPosition=row;data.Lane=lane;data.SourceType=symbol;
            chart.EditorEvents.Add(data is LaneHoldStartNote hold ? new EditorHoldNoteEvent(chart,hold,item[3].GetInt32()) : new EditorNoteEvent(chart,data));
        }
        if(request.TryGetProperty("Region",out var region)) chart.EditorEvents.Add(new EditorPatternEvent(chart,region[0].GetInt32(),region[1].GetInt32()));
        chart.Refresh();
        var originalHeads=chart.EditorEvents.OfType<EditorNoteEvent>().Select(note=>new {Row=note.GetRow(),Lane=note.Lane,Symbol=note.Symbol,Time=note.GetChartTime(),Fake=note.IsFake()}).ToArray();
        var originalCount=chart.GetStepTotals().GetStepCount();var originalEnd=chart.GetEndChartTime();
        var originalNps=new DensityReference(chart,request.GetProperty("NumSteps").GetInt32(),request.GetProperty("LastStep").GetInt32()).Run();
        object? conversion=null;
        if(request.TryGetProperty("Conversion",out var conversionOptions)) {
            var sourcePad=PadData.LoadPadData("dance-single",System.IO.Path.Combine(referenceRoot,"StepManiaLibrary","dance-single.json")).GetAwaiter().GetResult();
            var sourceGraph=StepGraph.Load(System.IO.Path.Combine(referenceRoot,"StepManiaLibrary","dance-single.fsg"),sourcePad);
            var targetPad=PadData.LoadPadData("dance-double",System.IO.Path.Combine(referenceRoot,"StepManiaLibrary","dance-double.json")).GetAwaiter().GetResult();
            var targetGraph=StepGraph.Load(System.IO.Path.Combine(referenceRoot,"StepManiaLibrary","dance-double.fsg"),targetPad);
            var events=new List<Event>();
            foreach(var entry in chart.EditorEvents.Where(e=>e is not EditorPatternEvent)) {events.Add(entry.GetEvent());var tail=entry.GetAdditionalEvent();if(tail!=null)events.Add(tail);}
            events.Sort(new SMEventComparer());
            var expression=new StepManiaLibrary.ExpressedChart.Config {BracketParsingDetermination=StepManiaLibrary.ExpressedChart.BracketParsingDetermination.UseDefaultMethod,DefaultBracketParsingMethod=StepManiaLibrary.ExpressedChart.BracketParsingMethod.Balanced};expression.Init();
            var expressed=StepManiaLibrary.ExpressedChart.ExpressedChart.CreateFromSMEvents(events,sourceGraph,expression,9.0,"Oracle");
            var config=JsonSerializer.Deserialize<StepManiaLibrary.PerformedChart.Config>(conversionOptions.GetProperty("PerformedConfig"),new JsonSerializerOptions {IncludeFields=true})!;config.Init();
            var roots=new List<List<GraphNode>> {new(){targetGraph.GetRoot()}};
            for(var tier=1;tier<targetPad.StartingPositions.Length;tier++)roots.Add(targetPad.StartingPositions[tier].Select(pos=>targetGraph.FindGraphNode(pos[0],GraphArrowState.Resting,pos[1],GraphArrowState.Resting)).ToList());
            var performed=expressed==null?null:StepManiaLibrary.PerformedChart.PerformedChart.CreateFromExpressedChart(targetGraph,config,roots,null,expressed,42,"Oracle");
            conversion=new {Success=performed!=null,Notes=performed?.CreateSMChartEvents().OfType<LaneNote>().Select(note=>new {Row=note.IntegerPosition,Lane=note.Lane,Symbol=note.SourceType}).ToArray()};
        }
        object? pipeline=null;
        object? projected=null;
        if(request.TryGetProperty("Projection",out var projection)) {
            var start=projection.GetProperty("Start").GetInt32();var end=projection.GetProperty("End").GetInt32();var spacing=projection.GetProperty("Spacing").GetInt32();
            var pattern=new EditorPatternEvent(chart,start,end,spacing);
            var changes=PatternDeletionReference.DeleteEventsOverlappingPatterns(chart,new[]{pattern});
            var rawRegion=projection.GetProperty("Region");
            var marker=new EditorPatternEvent(chart,rawRegion[0].GetInt32(),rawRegion[1].GetInt32(),spacing);
            marker.SetRowDependencies(chart.RateAlteringEvents.ForEvent(marker.Data).GetChartTimeFromPosition(marker.GetRow()),0,4,false);
            chart.AddEvents(new[]{marker});
            var regions=new List<object>();
            foreach(var range in projection.GetProperty("Ranges").EnumerateArray()) {
                var (events,editorEvents)=chart.GetEventsInRangeForPattern(range[0].GetInt32(),range[1].GetInt32());
                events.AddRange(chart.RateAlteringEvents.Select(rate=>rate.GetEvent()).Where(DoesEventAffectTiming));
                events.Sort(new SMEventComparer());
                regions.Add(new {
                    Span=new[]{events.FirstOrDefault()?.TimeSeconds??0.0,events.LastOrDefault()?.TimeSeconds??0.0},
                    Groups=events.GroupBy(e=>e.IntegerPosition).Select(group=>new {Row=group.Key,Time=group.First().TimeSeconds}).ToArray(),
                    EditorEvents=editorEvents.Select(e=>new {Row=e.GetRow(),Lane=e.GetLane(),Step=e.IsStep()}).ToArray()
                });
            }
            if(request.TryGetProperty("PatternConfig",out var patternJson)) {
                var pad=PadData.LoadPadData("dance-single",System.IO.Path.Combine(referenceRoot,"StepManiaLibrary","dance-single.json")).GetAwaiter().GetResult();
                var graph=StepGraph.Load(System.IO.Path.Combine(referenceRoot,"StepManiaLibrary","dance-single.fsg"),pad);
                var config=JsonSerializer.Deserialize<StepManiaLibrary.PerformedChart.Config>(request.GetProperty("Conversion").GetProperty("PerformedConfig"),new JsonSerializerOptions {IncludeFields=true})!;config.Init();pattern.Config=config;
                var patternConfig=JsonSerializer.Deserialize<StepManiaLibrary.PerformedChart.PatternConfig>(patternJson,new JsonSerializerOptions {IncludeFields=true,Converters={new System.Text.Json.Serialization.JsonStringEnumConverter()}})!;patternConfig.Init();
                var expression=new StepManiaLibrary.ExpressedChart.Config {BracketParsingDetermination=StepManiaLibrary.ExpressedChart.BracketParsingDetermination.UseDefaultMethod,DefaultBracketParsingMethod=StepManiaLibrary.ExpressedChart.BracketParsingMethod.Balanced};expression.Init();
                var bounds=PatternRangeReference.Run(pattern);
                var timing=chart.RateAlteringEvents.Select(e=>e.GetEvent()).Where(DoesEventAffectTiming).ToList();
                (StepManiaLibrary.ExpressedChart.ExpressedChart?,List<global::EditorEvent>) Interpret(int first,int last) {
                    var (events,editor)=chart.GetEventsInRangeForPattern(first,last);events.AddRange(timing);events.Sort(new SMEventComparer());
                    return (StepManiaLibrary.ExpressedChart.ExpressedChart.CreateFromSMEvents(events,graph,expression,9.0,"Oracle"),editor.Select(e=>new global::EditorEvent(e.GetRow(),e.GetLane(),e.IsStep())).ToList());
                }
                var (after,afterEvents)=Interpret(end+1,bounds.end);var (before,beforeEvents)=Interpret(bounds.start,start-1);
                var counts=new int[4];var total=0;
                foreach(var entry in chart.EditorEvents.Where(e=>e.GetRow()<start && e.IsStep())) {counts[entry.GetLane()]++;total++;}
                var nps=new DensityReference(chart,pattern.GetNumSteps(),end).Run();
                object? notes=null;object? context=null;
                if(after!=null && before!=null) {
                    var values=global::PatternContextReference.Run(new global::EditorPatternEvent(start,end,pattern.GetNumSteps(),config),graph,before,after,beforeEvents,afterEvents,total,bounds.start>0);context=values;
                    var generated=StepManiaLibrary.PerformedChart.PerformedChart.CreateWithPattern(graph,patternConfig,config,start,end,42,values.PreviousFoot,values.PreviousTimes,values.PreviousFooting,values.FollowingFooting,counts,values.SameCounts,timing,total,values.LastTransitionSteps,values.LastTransitionLeft,nps,"Oracle");
                    notes=generated?.CreateSMChartEvents().OfType<LaneNote>().Select(e=>new {Row=e.IntegerPosition,Lane=e.Lane,Symbol=e.SourceType}).ToArray();
                }
                pipeline=new {Success=notes!=null,Notes=notes,Context=context,Nps=nps,Bounds=new[]{bounds.start,bounds.end}};
            }
            projected=new {
                Heads=chart.EditorEvents.OfType<EditorNoteEvent>().Select(note=>new {Row=note.GetRow(),Lane=note.Lane,Symbol=note.Symbol,Time=note.GetChartTime(),Fake=note.IsFake(),End=note is EditorHoldNoteEvent hold?(int?)hold.GetEndChartPosition():null}).ToArray(),
                StepCount=chart.GetStepTotals().GetStepCount(),End=chart.GetEndChartTime(),
                Nps=new DensityReference(chart,projection.GetProperty("NumSteps").GetInt32(),end).Run(),
                Regions=regions,Removed=changes.DeletedEvents.Distinct().Count(),Shortened=changes.ShortenedHolds.Count
            };
        }
        return new {
            Conversion=conversion,Projected=projected,Pipeline=pipeline,
            Heads=originalHeads,
            StepCount=originalCount,End=originalEnd,
            Times=request.GetProperty("Rows").EnumerateArray().Select(row=>{double time=0;chart.TryGetTimeFromChartPosition(row.GetDouble(),ref time);return time;}).ToArray(),
            Nps=originalNps
        };
    }
}
