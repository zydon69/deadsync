internal static class Reference{
    public static object Run(JsonElement input){
        System.Globalization.CultureInfo.CurrentCulture=System.Globalization.CultureInfo.InvariantCulture;
        var source=new Dictionary<double,string>();new CSVListAtTimePropertyParser<string>("LABELS",source).Parse(new MSDFile.Value {Params=["LABELS",input.GetProperty("Source").GetString()!]});
        var chart=new Chart{Layers=[new Layer()]};SMCommon.AddLabelEvents(source,chart,new TempoOracle.SilentLogger(),false);var store=new PauseOracle.EditorChart();var nodes=new SortedDictionary<int,EditorLabelEvent>();
        foreach(var label in chart.Layers[0].Events.OfType<Label>())nodes[label.IntegerPosition]=new(label.IntegerPosition,label);
        store.EditorEvents.AddRange(nodes.Values);
        object Values()=>nodes.Select(pair=>new{Row=pair.Key,Text=pair.Value.StringValue}).ToArray();var initial=Values();
        object Navigation(){var tree=new NavigationTree();foreach(var row in nodes.Keys)tree.Insert(new EditorEvent(row));return new long[]{0,1,11,12,13,23,24,25,47,48,49,71,72,73,239,240,241,int.MaxValue}.Select(row=>new{Row=row,Previous=tree.FindPreviousEventWithLooping(row)?.GetRow(),Next=tree.FindNextEventWithLooping(row)?.GetRow()}).ToArray();}
        var initialNavigation=Navigation();var stages=new List<object>();
        foreach(var op in input.GetProperty("Operations").EnumerateArray()){
            var kind=op[0].GetString();var row=op[1].GetInt32();bool changed=false;string? error=null;
            if(kind=="set"){
                var text=op[2].GetString()!;var (_,clean)=EditorLabelEvent.IsValidLabelString(text);
                if(nodes.TryGetValue(row,out var node)){var before=node.StringValue;node.StringValue=text;changed=before!=node.StringValue;}
                else{nodes[row]=new(row,new(clean));store.EditorEvents.Add(nodes[row]);changed=true;}
            }else if(kind=="remove"){
                if(nodes.Remove(row,out var node)){store.EditorEvents.Remove(node);changed=true;}
            }else if(kind=="move"){
                var target=op[2].GetInt32();if(!nodes.TryGetValue(row,out var node))error="missing";else if(row==target){}else if(!store.CanEventBeMovedToRow(node,target))error="collision";else{nodes.Remove(row);nodes[target]=node;node.Row=target;changed=true;}
            }
            stages.Add(new{Changed=changed,Error=error,Values=Values(),Navigation=Navigation()});
        }
        return new{Initial=initial,InitialNavigation=initialNavigation,Stages=stages,Sanitized=input.GetProperty("Sanitize").EnumerateArray().Select(value=>new{Input=value.GetString(),Text=EditorLabelEvent.IsValidLabelString(value.GetString()!).Item2}).ToArray()};
    }
}
