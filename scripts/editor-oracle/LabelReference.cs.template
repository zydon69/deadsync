// Row-only event adapters; searches and enumerators use the actual Fumen tree.
// Looping search methods below are extracted unchanged from GrooveAuthor.
internal sealed class EditorEvent(int row):IComparable<EditorEvent>{
    public int GetRow()=>row;
    public int CompareTo(EditorEvent? other)=>other is null?1:row.CompareTo(other.GetRow());
}
internal sealed class NavigationTree:RedBlackTree<EditorEvent>{
    private IReadOnlyRedBlackTree<EditorEvent>.IReadOnlyRedBlackTreeEnumerator FindGreatestBeforeChartPosition(double row)
        =>FindGreatestPreceding(row,(node,value)=>((double)node.GetRow()).CompareTo(value));
    private IReadOnlyRedBlackTree<EditorEvent>.IReadOnlyRedBlackTreeEnumerator FindLeastAfterChartPosition(double row)
        =>FindLeastFollowing(row,(node,value)=>((double)node.GetRow()).CompareTo(value));
